<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect /blog to external WordPress blog
  RewriteRule ^blog(/.*)?$ https://brandsenvoy.com/blog/ [R=301,L]

  # Forward /api requests directly to api/index.php
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # Serve physical files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect legacy article slugs (e.g. /my-old-post) to https://brandsenvoy.com/blog/my-old-post/
  RewriteCond %{REQUEST_URI} !^/(why-us|who-we-serve|our-work|talk-to-us|markets|political-campaigns|services|clutch-reviews|affiliate-marketing|affiliate-admin|api|assets) [NC]
  RewriteRule ^([a-zA-Z0-9\-]+)/?$ https://brandsenvoy.com/blog/$1/ [R=301,L]

  # Route all other SPA pages to index.html
  RewriteRule ^ index.html [L]
</IfModule>
